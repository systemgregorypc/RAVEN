<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Raven Neural — Generador de Imágenes IA</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Segoe UI', system-ui, sans-serif; }
        body { background: #050505; color: #f8fafc; height: 100vh; display: flex; flex-direction: column; overflow: hidden; border-top: 3px solid #8b5cf6; }

        /* Encabezado Superior */
        header { height: 55px; background: #0a0a0a; border-bottom: 1px solid #1f1f1f; padding: 0 24px; display: flex; align-items: center; justify-content: space-between; }
        .logo { font-size: 1.1rem; font-weight: bold; color: #a78bfa; display: flex; align-items: center; gap: 8px; letter-spacing: 0.5px; }
        .logo span { background: rgba(139, 92, 246, 0.15); color: #a78bfa; font-size: 0.7rem; padding: 3px 8px; border-radius: 4px; border: 1px solid rgba(139, 92, 246, 0.35); }

        .header-links { font-size: 0.8rem; color: #737373; }
        .header-links a { color: #a78bfa; text-decoration: none; }

        /* Área de Trabajo Principal: Imagen Arriba */
        .stage { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 20px; position: relative; background: radial-gradient(circle at center, #100a1d 0%, #050505 80%); }
        
        .image-container { width: 100%; max-width: 800px; aspect-ratio: 16 / 9; background: #0b0b0f; border: 2px solid #221e33; border-radius: 14px; position: relative; overflow: hidden; box-shadow: 0 25px 60px rgba(0, 0, 0, 0.9), 0 0 35px rgba(139, 92, 246, 0.12); display: flex; align-items: center; justify-content: center; }
        .image-container.active { border-color: #8b5cf6; }

        #resultImage { width: 100%; height: 100%; object-fit: cover; display: none; }

        /* Placeholder visual inicial antes de generar */
        .placeholder-content { text-align: center; color: #737373; padding: 20px; }
        .placeholder-content svg { width: 54px; height: 54px; margin-bottom: 12px; stroke: #525252; }
        .placeholder-content h3 { font-size: 1.05rem; color: #d4d4d8; margin-bottom: 4px; }
        .placeholder-content p { font-size: 0.85rem; }

        /* Spinner de carga */
        .loader-overlay { position: absolute; inset: 0; background: rgba(5, 5, 5, 0.85); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px; z-index: 10; opacity: 0; pointer-events: none; transition: opacity 0.2s; }
        .loader-overlay.visible { opacity: 1; pointer-events: auto; }
        .spinner { width: 42px; height: 42px; border: 3px solid #221e33; border-top-color: #8b5cf6; border-radius: 50%; animation: spin 0.8s linear infinite; }
        @keyframes spin { to { transform: rotate(360deg); } }
        .loader-text { font-size: 0.85rem; color: #a78bfa; font-weight: 500; letter-spacing: 0.5px; }

        /* Barra Inferior de Comando (Texto Abajo) */
        .prompt-dock { background: #0a0a0a; border-top: 1px solid #1f1f1f; padding: 16px 24px; display: flex; flex-direction: column; align-items: center; gap: 10px; }
        .prompt-box { width: 100%; max-width: 800px; display: flex; gap: 10px; background: #121118; border: 1px solid #2a243d; padding: 8px; border-radius: 10px; transition: border-color 0.2s; }
        .prompt-box:focus-within { border-color: #8b5cf6; }

        .prompt-box input { flex: 1; background: transparent; border: none; color: #ffffff; font-size: 0.95rem; padding: 8px 12px; outline: none; }
        .prompt-box input::placeholder { color: #6b7280; }

        .btn-generate { background: #8b5cf6; color: #ffffff; border: none; padding: 10px 24px; border-radius: 7px; font-weight: bold; font-size: 0.9rem; cursor: pointer; transition: transform 0.15s, background 0.2s; white-space: nowrap; display: flex; align-items: center; gap: 6px; }
        .btn-generate:hover { background: #7c3aed; transform: scale(1.02); }
        .btn-generate:disabled { background: #262626; color: #737373; cursor: not-allowed; transform: none; }

        .btn-download { background: #10b981; color: #ffffff; border: none; padding: 8px 16px; border-radius: 7px; font-weight: bold; font-size: 0.85rem; cursor: pointer; display: none; align-items: center; gap: 6px; transition: background 0.2s; }
        .btn-download:hover { background: #059669; }

        .dock-footer { width: 100%; max-width: 800px; display: flex; justify-content: space-between; align-items: center; font-size: 0.75rem; color: #737373; padding: 0 4px; }
    </style>
</head>
<body>

    <header>
        <div class="logo">⚡ RAVEN <span>Neural Vision</span></div>
        <div class="header-links">Ecosistema <a href="https://github.com/systemgregorypc/RAVEN" target="_blank">RAVEN GitHub</a></div>
    </header>

    <main class="stage">
        <div class="image-container" id="imageContainer">
            <!-- Pantalla de carga superpuesta -->
            <div class="loader-overlay" id="loaderOverlay">
                <div class="spinner"></div>
                <div class="loader-text" id="loaderText">Neural IA sintetizando imagen...</div>
            </div>

            <!-- Estado Inicial / Placeholder -->
            <div class="placeholder-content" id="placeholder">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-1.5-1.5H3.75A1.5 1.5 0 0 0 2.25 6v12a1.5 1.5 0 0 0 1.5 1.5Zm10.5-11.25h.008v.008h-.008V8.25Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
                </svg>
                <h3>Tu lienzo visual está listo</h3>
                <p>Escribe abajo lo que imaginas y pulsa Generar Imagen</p>
            </div>

            <!-- Imagen Generada Real -->
            <img id="resultImage" alt="Imagen generada por IA" />
        </div>
    </main>

    <footer class="prompt-dock">
        <div class="prompt-box">
            <input type="text" id="promptInput" placeholder="Ej. Un lobo cibernético bajo una lluvia de neón púpura, alta definición..." />
            <button class="btn-generate" id="genBtn" onclick="generarImagen()">
                <span>✨ Generar Imagen</span>
            </button>
        </div>
        <div class="dock-footer">
            <span id="statusInfo">Motor IA: Conectado y listo</span>
            <button class="btn-download" id="downloadBtn" onclick="descargarImagen()">💾 Descargar Imagen PC / USB</button>
        </div>
    </footer>

    <script>
        const promptInput = document.getElementById('promptInput');
        const genBtn = document.getElementById('genBtn');
        const downloadBtn = document.getElementById('downloadBtn');
        const resultImage = document.getElementById('resultImage');
        const placeholder = document.getElementById('placeholder');
        const loaderOverlay = document.getElementById('loaderOverlay');
        const loaderText = document.getElementById('loaderText');
        const imageContainer = document.getElementById('imageContainer');
        const statusInfo = document.getElementById('statusInfo');

        let ultimaUrlImagen = "";

        async function generarImagen() {
            const promptText = promptInput.value.trim();
            if (!promptText) {
                alert("Por favor escribe una descripción para la imagen.");
                return;
            }

            // UI Estado de Carga
            genBtn.disabled = true;
            loaderOverlay.classList.add('visible');
            loaderText.textContent = "Conectando con red neuronal...";
            imageContainer.classList.add('active');
            statusInfo.textContent = "Procesando solicitud...";

            try {
                // Codificar prompt para URL de la API de IA en tiempo real
                const promptCodificado = encodeURIComponent(promptText + ", highly detailed, 4k resolution, cinematic lighting");
                const seedAleatorio = Math.floor(Math.random() * 1000000);
                
                // Endpoint público de IA de alto rendimiento (Stable Diffusion / Flux engine)
                const imageUrl = `https://image.pollinations.ai/prompt/${promptCodificado}?width=1280&height=720&seed=${seedAleatorio}&nologo=true`;

                // Precargar la imagen para asegurar que esté lista antes de mostrarla
                const imgLoader = new Image();
                imgLoader.src = imageUrl;

                imgLoader.onload = () => {
                    resultImage.src = imageUrl;
                    ultimaUrlImagen = imageUrl;
                    resultImage.style.display = 'block';
                    placeholder.style.display = 'none';
                    loaderOverlay.classList.remove('visible');
                    genBtn.disabled = false;
                    downloadBtn.style.display = 'flex';
                    statusInfo.textContent = "✅ ¡Imagen generada con éxito!";
                };

                imgLoader.onerror = () => {
                    throw new Error("No se pudo cargar la imagen desde el servidor de IA.");
                };

            } catch (error) {
                loaderOverlay.classList.remove('visible');
                genBtn.disabled = false;
                statusInfo.textContent = "❌ Error al generar la imagen";
                alert("Ocurrió un error de red: " + error.message);
            }
        }

        async function descargarImagen() {
            if (!ultimaUrlImagen) return;
            try {
                statusInfo.textContent = "Descargando imagen...";
                const response = await fetch(ultimaUrlImagen);
                const blob = await response.blob();
                const blobUrl = URL.createObjectURL(blob);
                
                const a = document.createElement('a');
                a.href = blobUrl;
                a.download = `raven_ia_${Date.now()}.jpg`;
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                
                statusInfo.textContent = "✅ Imagen guardada correctamente en tu dispositivo";
            } catch (e) {
                window.open(ultimaUrlImagen, '_blank');
            }
        }

        promptInput.addEventListener('keydown', (e) => {
            if (e.key === 'Enter') generarImagen();
        });
    </script>
</body>
</html>
